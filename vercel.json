{
  "framework": null,
  "buildCommand": "echo 'Sin build en Vercel: public/ ya viene generado (python3 tools/build.py en local)'",
  "outputDirectory": "public",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/framerusercontent.com/sites/70yiSpZyA9Z5dxDKIiuNjl-:version/:path*",
      "destination": "/framerusercontent.com/sites/70yiSpZyA9Z5dxDKIiuNjl/:path*"
    },
    {
      "source": "/diagnostico",
      "destination": "/diagnostico.html"
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:path+/index.html",
      "destination": "/:path+",
      "permanent": true
    },
    {
      "source": "/:path+/index",
      "destination": "/:path+",
      "permanent": true
    },
    {
      "source": "/:path((?!e35445b6-9b36-474d-a3dc-2cc36fe1c7b3\\.html).+)\\.html",
      "destination": "/:path",
      "permanent": true
    },
    {
      "source": "/contacto",
      "destination": "/#hablemos",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/framerusercontent.com/sites/70yiSpZyA9Z5dxDKIiuNjl-:version/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts.gstatic.com/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/banteq/:archivo(banteq\\.css|banteq\\.js|banteq-liquid\\.js|banteq-ca\\.js)",
      "has": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/diagnosticos.js": {
      "maxDuration": 120
    }
  }
}
