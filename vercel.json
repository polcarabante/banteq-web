{
  "framework": null,
  "buildCommand": "echo 'Sin build en Vercel: public/ ya viene generado (python3 tools/build.py en local)'",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/framerusercontent.com/sites/70yiSpZyA9Z5dxDKIiuNjl-:version/:path*",
      "destination": "/framerusercontent.com/sites/70yiSpZyA9Z5dxDKIiuNjl/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/contacto",
      "destination": "/#hablemos",
      "permanent": true
    },
    {
      "source": "/inteligencia-artificial",
      "destination": "/automatizacion-procesos",
      "permanent": true
    }
  ],
  "functions": {
    "api/diagnosticos.js": {
      "maxDuration": 120
    }
  }
}
